{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi carry",
  "version": "0.3.2",
  "identifier": "dev.picarry.desktop",
  "build": {
    "frontendDist": "../../design/desktop-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pi carry",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#05050A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pi-carry"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/y-cyfor/Pi-Carry/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNzMyQjA4Njg3RDAyNDUKUldSRkFuMW9DQ3R6VVoyaDN3KzZpdUxIQ0h4aVFSaW1KMk5leVNETnMwbFdlY3Btc2VtM3krK1EK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
