{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi carry",
  "version": "0.1.1",
  "identifier": "dev.picarry.desktop",
  "build": {
    "frontendDist": "../../desktop-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pi carry",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#05050A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
